<% layout('layouts/boilerplate') %>

<% contentTitle = 'Index health' %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="mb-1"><i class="fas fa-heart-pulse me-2"></i>Database Index Health</h1>
    <p class="text-muted mb-0">
      Database: <code><%= report.dbName %></code>
    </p>
  </div>
  <div class="d-flex gap-2">
    <span class="badge bg-success fs-6">OK: <%= report.counts.ok %></span>
    <span class="badge bg-warning text-dark fs-6">Missing: <%= report.counts.missing %></span>
    <span class="badge bg-danger fs-6">Conflicts: <%= report.counts.conflict %></span>
    <span class="badge bg-dark fs-6">Errors: <%= report.counts.error %></span>
  </div>
</div>

<% if (issues.length > 0) { %>
  <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
    <i class="fas fa-triangle-exclamation mt-1"></i>
    <div>
      <strong>Action required:</strong> some indexes are missing or conflicting.
      Run `pnpm --filter tracker exec node utils/reconcileIndexes.js --apply --drop-conflicting-indexes`.
    </div>
  </div>
<% } else { %>
  <div class="alert alert-success d-flex align-items-start gap-2" role="alert">
    <i class="fas fa-circle-check mt-1"></i>
    <div>
      All required tracker and session indexes are healthy.
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><i class="fas fa-list-check me-2"></i>Index Report</h5>
    <span class="badge bg-secondary"><%= report.summary.length %> checks</span>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>Collection</th>
            <th>Index</th>
            <th>Status</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          <% report.summary.forEach(function(item) { %>
            <tr>
              <td><code><%= item.collectionName %></code></td>
              <td><code><%= item.indexName %></code></td>
              <td>
                <% if (item.status === 'ok') { %>
                  <span class="badge bg-success">ok</span>
                <% } else if (item.status === 'missing') { %>
                  <span class="badge bg-warning text-dark">missing</span>
                <% } else if (item.status === 'conflict') { %>
                  <span class="badge bg-danger">conflict</span>
                <% } else if (item.status === 'error') { %>
                  <span class="badge bg-danger">error</span>
                <% } else { %>
                  <span class="badge bg-secondary"><%= item.status %></span>
                <% } %>
              </td>
              <td>
                <% if (item.existingName) { %>
                  Existing: <code><%= item.existingName %></code>
                <% } else if (item.message) { %>
                  <span class="text-danger"><%= item.message %></span>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
