<nav class="navbar navbar-expand-md sticky-top navbar-dark bg-dark">
  <% const currentPathValue = typeof currentPath === "string" ? currentPath : ""; %>
  <% const isAuthenticated = typeof trackerUser !== "undefined" && Boolean(trackerUser); %>
  <div class="container-fluid">
    <a class="navbar-brand" href="<%= isAuthenticated ? '/admin' : '/auth/login' %>">
      <i class="fas fa-chart-line me-2"></i>Tracker
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#trackerNavbar"
      aria-controls="trackerNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="trackerNavbar">
      <% if (isAuthenticated) { %>
      <div class="navbar-nav ms-auto">
        <a class="nav-link <%= currentPathValue === '/admin' ? 'active' : '' %>" href="/admin">
          <i class="fas fa-tachometer-alt me-1"></i>Dashboard
        </a>
        <a class="nav-link <%= currentPathValue === '/admin/tracker' ? 'active' : '' %>" href="/admin/tracker">
          <i class="fas fa-database me-1"></i>Tracker Data
        </a>
        <a class="nav-link <%= currentPathValue === '/admin/flagged-ips' ? 'active' : '' %>" href="/admin/flagged-ips">
          <i class="fas fa-shield-alt me-1"></i>Flagged IPs
        </a>
        <a class="nav-link <%= currentPathValue === '/admin/blocked-ips' ? 'active' : '' %>" href="/admin/blocked-ips">
          <i class="fas fa-ban me-1"></i>Blocked IPs
        </a>
        <a class="nav-link <%= currentPathValue === '/admin/summary' ? 'active' : '' %>" href="/admin/summary">
          <i class="fas fa-calendar-week me-1"></i>Summary
        </a>
        <a class="nav-link <%= currentPathValue === '/admin/contact-outcomes' ? 'active' : '' %>" href="/admin/contact-outcomes">
          <i class="fas fa-envelope me-1"></i>Contact Outcomes
        </a>
        <a class="nav-link <%= currentPathValue === '/admin/index-health' ? 'active' : '' %>" href="/admin/index-health">
          <i class="fas fa-heart-pulse me-1"></i>Index Health
        </a>
        <a class="nav-link <%= currentPathValue === '/admin/accounts' ? 'active' : '' %>" href="/admin/accounts">
          <i class="fas fa-user-gear me-1"></i>Accounts
        </a>
        <form method="POST" action="/auth/logout" class="d-flex align-items-center ms-2">
          <button class="btn btn-outline-light btn-sm" type="submit">
            <i class="fas fa-right-from-bracket me-1"></i>Logout
          </button>
        </form>
      </div>
      <% } else { %>
      <div class="navbar-nav ms-auto">
        <a class="nav-link <%= currentPathValue === '/auth/login' ? 'active' : '' %>" href="/auth/login">
          <i class="fas fa-right-to-bracket me-1"></i>Login
        </a>
      </div>
      <% } %>
    </div>
  </div>
</nav>
