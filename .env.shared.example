# Mongodb Atlas
MONGODB=your_mongodb_password
MONGODB_DB_NAME=longrunner-platform

# Cloudfare Turnstyle (reCAPTCHA) and Anti-Spam
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ALLOWED_HOSTNAMES=longrunner.co.uk,blog.longrunner.co.uk,quiz.longrunner.co.uk,slapp.longrunner.co.uk
CONTACT_MIN_SUBMIT_MS=4000
CONTACT_MAX_SUBMIT_MS=7200000
CONTACT_DEDUPE_WINDOW_MINUTES=1440
CONTACT_DEDUPE_RETENTION_HOURS=168
CONTACT_DNS_TIMEOUT_MS=2500
CONTACT_SUPPRESSION_FILE=/run/config/suppressed-emails.txt
CONTACT_EVENT_RETENTION_DAYS=90

# Session
SESSION_KEY=your_session_secret
DEFAULT_USER_ID=your_default_user_id

# Email
EMAIL_USER=user@example.com
ALIAS_EMAIL=alias@example.com
ZOHOPW=your_zoho_password

# Tracker
TRACKER_AUTO_BLOCK_NOTIFY_TO=notify@example.com
TRACKER_FLAG_THRESHOLD=10
TRACKER_BAD_TO_GOOD_RATIO_THRESHOLD=1.7
TRACKER_BLOCK_30M_THRESHOLD=20
TRACKER_BLOCK_24H_THRESHOLD=50
TRACKER_BLOCK_30M_DURATION_MINUTES=30
TRACKER_BLOCK_24H_DURATION_HOURS=24
TRACKER_AUTO_BLOCK_EMAIL_ENABLED=true
TRACKER_WEEKLY_SUMMARY_EMAIL_ENABLED=true
TRACKER_WEEKLY_SUMMARY_EMAIL_TO=notify@example.com
TRACKER_WEEKLY_SUMMARY_EMAIL_TIME=00:05
TRACKER_WEEKLY_SUMMARY_TIMEZONE=Europe/London
TRACKER_AUTO_RECONCILE_INDEXES=false
IP_WHITE_LIST=
IP_DEV_LIST=
TRACKER_EVENT_RETENTION_DAYS=30
TRACKER_BLOCKED_IP_CACHE_TTL_MS=10000ms
